# Clés et identifiants (Google Sheets, etc.)
credentials/
credentials.json
token.json
service_account*.json
.env

# JSON ignorés par défaut, sauf la configuration livrée.
# config/config.json est la copie locale de l'onglet config (réécrite à chaque lancement) : non suivie.
*.json
!config/defaults.json
!config/bootstrap.json

# Base de données locale
*.sqlite
*.sqlite-journal
*.db

# Exports CSV déposés à la main (données, pas du code)
data/imports/**/*.csv

# Fichiers de travail
*.log
Sans nom*.csv

# Environnement virtuel et cache Python
venv/
.venv/
__pycache__/
*.pyc
.idea/
.vscode/

# Projections finales exportées
exports/
!tests/fixtures/*.json
